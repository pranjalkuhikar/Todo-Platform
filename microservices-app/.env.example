# Copy to .env.  NEVER commit the real .env.
# Generate secrets with:  openssl rand -hex 32

# Shared secret that proves a request came from the gateway (gateway + todo-service).
INTERNAL_TOKEN=change-me-generate-with-openssl-rand-hex-16

# Sign-in: this app has no login of its own. Users sign in at the central AuthHub (run it on :4500).
# AUTHHUB_URL is how the BROWSER reaches AuthHub. Leave the default for local development.
AUTHHUB_URL=http://localhost:4500

POSTGRES_PASSWORD=app

# Browser origins allowed to send POST/PATCH/DELETE (comma separated). Use your real https domain in production.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
# number of reverse proxies / load balancers in front of the gateway (so rate limits see real client IPs)
TRUST_PROXY=0

# Product analytics (optional, same providers as the other apps): set one or both
POSTHOG_KEY=
MIXPANEL_TOKEN=
# Push logs to Loki (optional), e.g. http://host.docker.internal:3100 to use the existing observability lab
LOKI_URL=
