# Copy to .env.local and adjust. Never commit the real file.

# Where this hub is reachable by browsers (also the token issuer URL apps use to fetch public keys)
AUTHHUB_URL=http://localhost:4500

# Postgres. The database is created automatically if it does not exist.
DATABASE_URL=postgres://app:app@localhost:5432/authhub

# First-run admin account (only used while the users table is empty).
# If ADMIN_PASSWORD is omitted, a random one is generated and printed once in the server log.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Registered apps are seeded on first run with these URLs (editable later in the Admin console)
APP_NEXTJS_URL=http://localhost:3000
APP_NODE_URL=http://localhost:4000
APP_MICROSERVICES_URL=http://localhost:8080

# Access token lifetime in seconds (short = faster revocation; sessions silently renew it)
ACCESS_TTL_SECONDS=600

# Set true when served over HTTPS (always, in real production)
COOKIE_SECURE=false
# Production: share the login across subdomains, e.g. .example.com. Leave empty locally.
COOKIE_DOMAIN=
