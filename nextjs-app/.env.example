# Copy to .env.local (optional; defaults work with docker-compose)
DATABASE_URL=postgres://app:app@localhost:5432/nextapp
LOKI_URL=http://localhost:3100
# Product analytics (optional): set ONE or both
POSTHOG_KEY=
MIXPANEL_TOKEN=

# Sign-in through the central AuthHub (http://localhost:4500) is ON by default.
# Set to false ONLY for automated tests / load tests that call the API without logging in.
# AUTH_REQUIRED=false
