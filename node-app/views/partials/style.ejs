<style>
:root{--bg:#f5f6fb;--card:#fff;--ink:#16192c;--muted:#6b7190;--line:#e4e7f2;--brand:#4f46e5;--brand2:#7c3aed;--ok:#16a34a;--bad:#dc2626;--chip:#eef0fb;color-scheme:light}
@media (prefers-color-scheme:dark){:root{--bg:#0d1020;--card:#151a33;--ink:#e8ebfa;--muted:#8d95b8;--line:#262d52;--brand:#818cf8;--brand2:#a78bfa;--chip:#1c2244;color-scheme:dark}}
*{box-sizing:border-box}html,body{margin:0}body{background:var(--bg);color:var(--ink);font:15px/1.5 ui-sans-serif,-apple-system,"Segoe UI",Inter,system-ui,sans-serif}
a{color:var(--brand);text-decoration:none}a:hover{text-decoration:underline}
.top{position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--card) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.top .in{max-width:860px;margin:0 auto;padding:12px 20px;display:flex;align-items:center;gap:18px}
.brand{display:flex;align-items:center;gap:10px;font-weight:700;color:var(--ink)}.brand:hover{text-decoration:none}
.logo{width:32px;height:32px;border-radius:9px;background:linear-gradient(135deg,var(--brand),var(--brand2));display:grid;place-items:center;color:#fff;font-size:16px}
.links{display:flex;gap:4px;margin-left:8px}.links a{color:var(--muted);padding:5px 10px;border-radius:8px;font-size:13.5px}.links a:hover{background:var(--chip);text-decoration:none;color:var(--ink)}
.who{margin-left:auto;display:flex;align-items:center;gap:10px}
.avatar{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--brand),var(--brand2));color:#fff;display:grid;place-items:center;font-weight:700;font-size:14px}
.who .t{line-height:1.2;text-align:right}.who .t b{display:block;font-size:13.5px}.who .t span{font-size:12px;color:var(--muted)}
.btn,.pill,.who .t span,.who .t b{white-space:nowrap}.pill{display:inline-block;font-size:11px;font-weight:600;padding:1px 8px;border-radius:99px;background:var(--chip);color:var(--muted)}
.btn{font:inherit;font-size:13.5px;font-weight:600;border:1px solid var(--line);background:var(--card);color:var(--ink);padding:7px 14px;border-radius:10px;cursor:pointer;display:inline-block}
.btn:hover{border-color:var(--brand);text-decoration:none}.btn.primary{background:linear-gradient(135deg,var(--brand),var(--brand2));border:0;color:#fff}.btn.primary:hover{filter:brightness(1.08)}
.btn.out{color:var(--bad)}.btn.out:hover{border-color:var(--bad)}.btn.sm{padding:4px 10px;font-size:12.5px}.btn:disabled{opacity:.5}
main{max-width:860px;margin:0 auto;padding:28px 20px 60px}
h1{font-size:26px;margin:0 0 4px}.sub{color:var(--muted);margin:0 0 22px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:18px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px 16px}.stat b{font-size:24px;display:block;line-height:1.2}.stat span{color:var(--muted);font-size:12.5px}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;box-shadow:0 1px 2px rgba(20,24,60,.04)}
.add{display:flex;gap:10px;padding:14px;margin-bottom:16px}.add input[type=text]{flex:1}
input[type=text]{font:inherit;width:100%;padding:10px 13px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--ink);outline:none}
input[type=text]:focus{border-color:var(--brand);box-shadow:0 0 0 3px color-mix(in srgb,var(--brand) 22%,transparent)}
.tabs{display:flex;gap:6px;margin-bottom:12px}.tabs a{padding:5px 14px;border-radius:99px;font-size:13.5px;color:var(--muted);background:var(--chip)}.tabs a.on{background:var(--brand);color:#fff;text-decoration:none}
.list{list-style:none;margin:0;padding:0}.item{display:flex;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid var(--line)}.item:last-child{border-bottom:0}
.item form{margin:0}.check{width:24px;height:24px;border-radius:50%;border:2px solid var(--line);background:none;cursor:pointer;display:grid;place-items:center;color:#fff;font-size:13px;padding:0}.check:hover{border-color:var(--ok)}.done .check{background:var(--ok);border-color:var(--ok)}
.title{flex:1;min-width:0;overflow-wrap:anywhere}.done .title{text-decoration:line-through;color:var(--muted)}.meta{font-size:12px;color:var(--muted)}
.row-actions{display:flex;gap:6px;align-items:flex-start}details.edit summary{list-style:none;cursor:pointer}details.edit summary::-webkit-details-marker{display:none}
details.edit{margin-top:4px}details.edit summary{color:var(--brand);font-size:12.5px}details.edit[open] form{display:flex;gap:8px;margin-top:8px}
.empty{padding:40px 20px;text-align:center;color:var(--muted)}.empty b{display:block;color:var(--ink);font-size:17px;margin-bottom:4px}
.flash{padding:10px 14px;border-radius:12px;margin-bottom:14px;font-size:14px}.flash.ok{background:color-mix(in srgb,var(--ok) 14%,transparent);color:var(--ok)}.flash.err{background:color-mix(in srgb,var(--bad) 14%,transparent);color:var(--bad)}
.pager{display:flex;justify-content:space-between;align-items:center;margin-top:14px;color:var(--muted);font-size:13.5px}
.foot{margin-top:28px;text-align:center;color:var(--muted);font-size:12.5px}
@media(max-width:640px){.links{display:none}.who .t{display:none}}
</style>
